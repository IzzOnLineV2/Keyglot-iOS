/* ===== About ===== */
"Keyglot translates or rewrites the message you've already typed — in place, without copy/paste. Tap a language for a natural translation (source language auto-detected), or tap a tone to improve or restyle your text in the same language." = "Keyglot은 이미 입력한 메시지를 그 자리에서 번역하거나 다시 씁니다 — 복사·붙여넣기 없이. 언어를 탭하면 자연스러운 번역(원본 언어 자동 감지), 톤을 탭하면 같은 언어로 문장을 다듬거나 다시 쓸 수 있습니다.";
"How it works" = "사용 방법";
"Type your message in any app with your normal keyboard." = "평소 키보드로 아무 앱에서나 메시지를 입력하세요.";
"Tap 🌐 to switch to the Keyglot keyboard." = "🌐를 탭해 Keyglot 키보드로 전환하세요.";
