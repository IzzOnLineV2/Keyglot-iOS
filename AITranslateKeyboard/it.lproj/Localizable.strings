"About" = "Info";
"Enter your %@ API key above." = "Inserisci sopra la tua chiave API %@.";
"Open iOS Settings → General → Keyboard → Keyboards → Add New Keyboard… and add “Keyglot”." = "Apri Impostazioni iOS → Generali → Tastiera → Tastiere → Aggiungi nuova tastiera… e aggiungi “Keyglot”.";
