/* ===== Onboarding ===== */
"AI Message Translator" = "Traduttore di messaggi AI";
"Type in any language and replace your message with a natural translation — right inside WhatsApp, no copy/paste." = "Scrivi in qualsiasi lingua e sostituisci il messaggio con una traduzione naturale — direttamente in WhatsApp, senza copia-incolla.";
"Provider" = "Provider";
"Add your %@ API key to get started." = "Aggiungi la tua chiave API %@ per iniziare.";
"Reveal key" = "Mostra chiave";
"Get a %@ API key" = "Ottieni una chiave API %@";
"Stored securely in the iOS Keychain on this device — never in plain settings, and shared only with the keyboard." = "Salvata in modo sicuro nel Keychain di iOS su questo dispositivo — mai in impostazioni in chiaro, e condivisa solo con la tastiera.";
"Get Started" = "Inizia";
"Couldn't save the key" = "Impossibile salvare la chiave";
"The key couldn't be written to the iOS Keychain. Run the app signed with your Team (from Xcode) or on a device, then try again." = "Impossibile scrivere la chiave nel Keychain di iOS. Esegui l'app firmata con il tuo Team (da Xcode) o su un dispositivo, poi riprova.";

