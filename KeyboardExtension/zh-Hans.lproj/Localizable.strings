/* ===== Status line ===== */
"Enable Full Access in Settings to translate." = "请在设置中允许完全访问以进行翻译。";
"Open the Keyglot app to add your API key." = "打开 Keyglot App 添加你的 API 密钥。";
"Tap 🌐 to type on your keyboard, then come back here and pick a language." = "点按 🌐 用你的键盘输入，然后回到这里选择一种语言。";
"Tap a flag to translate your message." = "点按一面旗帜来翻译你的消息。";
"Translating to %@…" = "正在翻译为 %@…";
"Translate to %@" = "翻译为 %@";

/* ===== Error banners ===== */
"No API key set — add your %@ key in the Keyglot app." = "未设置 API 密钥——请在 Keyglot App 中添加你的 %@ 密钥。";
"Type a message first, then tap a language." = "请先输入消息，然后点按一种语言。";
"Invalid API key — open the Keyglot app and check your %@ key." = "API 密钥无效——打开 Keyglot App 检查你的 %@ 密钥。";
"Billing issue — add credit to your %@ account." = "计费问题——请为你的 %@ 账户充值。";
"Access denied — your %@ key isn't allowed to do this." = "访问被拒绝——你的 %@ 密钥无权执行此操作。";
"Out of credit — add billing to your %@ account." = "余额不足——请为你的 %@ 账户添加付款方式。";
"%@ rejected the request: %@" = "%@ 拒绝了请求：%@";
"Model not available for your %@ key." = "你的 %@ 密钥无法使用该模型。";
"Too many requests — wait a few seconds and try again." = "请求过多——请等待几秒后重试。";
"%@ is temporarily unavailable — try again shortly." = "%@ 暂时不可用——请稍后重试。";
"%@ error %lld: %@" = "%@ 错误 %lld：%@";
"No network — check your connection and that Full Access is on." = "无网络——请检查你的连接以及是否已开启完全访问。";
"%@ returned nothing — try again." = "%@ 未返回任何内容——请重试。";
"Unexpected response from %@." = "来自 %@ 的意外响应。";
"Couldn't translate: %@" = "无法翻译：%@";
