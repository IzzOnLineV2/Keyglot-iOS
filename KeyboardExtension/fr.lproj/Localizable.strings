/* ===== Error banners ===== */
"No API key set — add your %@ key in the Keyglot app." = "Aucune clé API — ajoutez votre clé %@ dans l'app Keyglot.";
"Type a message first, then tap a button." = "Saisissez d'abord un message, puis touchez un bouton.";
"Invalid API key — open the Keyglot app and check your %@ key." = "Clé API invalide — ouvrez l'app Keyglot et vérifiez votre clé %@.";
